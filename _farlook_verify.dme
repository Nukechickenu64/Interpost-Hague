#define UNIT_TEST
#include "Interpost-Hague.dme"
#include "code\unit_tests\lighting_los_tests.dm"
#include "code\unit_tests\lighting_multiz_tests.dm"

/datum/controller/subsystem/unit_tests/Initialize(timeofday)
	. = ..()
	SSticker.can_fire = FALSE
	queue = list(new /datum/unit_test/lighting_los_geometry, new /datum/unit_test/lighting_los_door, new /datum/unit_test/lighting_los_light, new /datum/unit_test/lighting_los_look_far, new /datum/unit_test/foundation/look_far_cull_mask, new /datum/unit_test/lighting_los_mesh, new /datum/unit_test/lighting_los_response, new /datum/unit_test/lighting_los_emission, new /datum/unit_test/lighting_los_drop_shadow, new /datum/unit_test/lighting_los_ao, new /datum/unit_test/lighting_multiz)
	log_unit_test("Running focused Artemis lighting and LOS regression tests.")

