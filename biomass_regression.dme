#define UNIT_TEST
#include "Interpost-Hague.dme"

/datum/controller/subsystem/machines
	runlevels = RUNLEVEL_GAME | RUNLEVEL_POSTGAME | RUNLEVEL_SETUP

/datum/controller/subsystem/unit_tests/Initialize(timeofday)
	. = ..()
	SSticker.can_fire = FALSE
	queue = list(new /datum/unit_test/biomass_workflow, new /datum/unit_test/biomass_consumers, new /datum/unit_test/biomass_processing, new /datum/unit_test/vat_access)
	log_unit_test("Running focused hydroponics biomass regression tests.")
