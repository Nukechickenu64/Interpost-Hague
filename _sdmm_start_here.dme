// Generated by StrongerDMM "Start From Here". Safe to delete; it is rewritten on every launch.
#include "Interpost-Hague.dme"

/world/New()
	. = ..()
	if(params["sdmm_x"])
		spawn(0)
			sdmm_start_here()

/proc/sdmm_start_here()
	while(GAME_STATE != RUNLEVEL_LOBBY)
		sleep(10)
	while(!length(GLOB.clients))
		sleep(10)

	var/turf/target = sdmm_find_target()
	if(!target)
		target = sdmm_load_map()
	if(!target)
		to_world("<span class='danger'>StrongerDMM: unable to find or load the start tile.</span>")
		return

	SSticker.master_mode = "extended"
	for(var/attempt in 1 to 10)
		if(GAME_STATE == RUNLEVEL_GAME)
			break
		for(var/mob/new_player/player in GLOB.player_list)
			player.ready = 1
		for(var/client/C in GLOB.clients)
			if(istype(C.mob, /mob/new_player))
				var/mob/new_player/lobby = C.mob
				lobby.ready = 1
		if(GAME_STATE == RUNLEVEL_LOBBY)
			SSticker.start_now()
		sleep(50)

	if(GAME_STATE != RUNLEVEL_GAME)
		to_world("<span class='danger'>StrongerDMM: the round did not start.</span>")
		return

	for(var/client/C in GLOB.clients)
		sdmm_place_client(C, target)

/proc/sdmm_place_client(client/C, turf/target)
	var/mob/M = C.mob
	if(istype(M, /mob/new_player))
		var/mob/living/carbon/human/H = new(target)
		if(C.prefs)
			C.prefs.copy_to(H)
		H.key = C.key
		qdel(M)
		M = H
	M.forceMove(target)
	to_chat(M, "<span class='notice'>StrongerDMM: started at [target.x], [target.y], [target.z].</span>")

/proc/sdmm_find_target()
	var/x = text2num(world.params["sdmm_x"])
	var/y = text2num(world.params["sdmm_y"])
	var/list/signature = splittext(world.params["sdmm_sig"], ";")
	for(var/z in 1 to world.maxz)
		if(sdmm_signature_matches(x, y, z, signature))
			return locate(x, y, z)
	return null

// Turf types can change at round start, so allow a couple of mismatches besides the center.
/proc/sdmm_signature_matches(x, y, z, list/signature)
	var/turf/center = locate(x, y, z)
	if(!center || signature.len < 9 || "[center.type]" != signature[5])
		return FALSE
	var/checked = 0
	var/mismatched = 0
	var/i = 0
	for(var/dy in -1 to 1)
		for(var/dx in -1 to 1)
			i++
			var/expected = signature[i]
			if(!expected)
				continue
			checked++
			var/turf/T = locate(x + dx, y + dy, z)
			if(!T || "[T.type]" != expected)
				mismatched++
	return checked && mismatched <= 2

/proc/sdmm_load_map()
	var/path = world.params["sdmm_map"]
	if(!path || !fexists(path))
		return null
	var/first_new_z = world.maxz + 1
	var/datum/map_template/template = new(list(path), "StrongerDMM start")
	template.load_new_z(1, 1)
	return locate(text2num(world.params["sdmm_x"]), text2num(world.params["sdmm_y"]), first_new_z + text2num(world.params["sdmm_z"]) - 1)
