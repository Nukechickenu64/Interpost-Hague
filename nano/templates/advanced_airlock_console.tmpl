<div class="item" style="padding-top: 10px">
	<div class="item">
		<div class="itemLabel">
			External Gas Amount:
		</div>
		<div class="itemContent">
			{{:helper.displayBar(data.external_pressure, 0, 200 * 2500 / (293.15 * 8.31), (data.external_pressure < 80 * 2500 / (293.15 * 8.31) || data.external_pressure > 120 * 2500 / (293.15 * 8.31)) ? 'bad' : (data.external_pressure < 95 * 2500 / (293.15 * 8.31) || data.external_pressure > 110 * 2500 / (293.15 * 8.31)) ? 'average' : 'good')}}
			<div class="statusValue">
				{{:data.external_pressure}} mol/tile
			</div>
		</div>
	</div>
	<div class="item">
		<div class="itemLabel">
			Chamber Gas Amount:
		</div>
		<div class="itemContent">
			{{:helper.displayBar(data.chamber_pressure, 0, 200 * 2500 / (293.15 * 8.31), (data.chamber_pressure < 80 * 2500 / (293.15 * 8.31) || data.chamber_pressure > 120 * 2500 / (293.15 * 8.31)) ? 'bad' : (data.chamber_pressure < 95 * 2500 / (293.15 * 8.31) || data.chamber_pressure > 110 * 2500 / (293.15 * 8.31)) ? 'average' : 'good')}}
			<div class="statusValue">
				{{:data.chamber_pressure}} mol/tile
			</div>
		</div>
	</div>
	<div class="item">
		<div class="itemLabel">
			Internal Gas Amount:
		</div>
		<div class="itemContent">
			{{:helper.displayBar(data.internal_pressure, 0, 200 * 2500 / (293.15 * 8.31), (data.internal_pressure < 80 * 2500 / (293.15 * 8.31) || data.internal_pressure > 120 * 2500 / (293.15 * 8.31)) ? 'bad' : (data.internal_pressure < 95 * 2500 / (293.15 * 8.31) || data.internal_pressure > 110 * 2500 / (293.15 * 8.31)) ? 'average' : 'good')}}
			<div class="statusValue">
				{{:data.internal_pressure}} mol/tile
			</div>
		</div>
	</div>
</div>
<div class="item" style="padding-top: 10px">
	<div class="item" style="width: auto; float: left">
		<div class="itemContent">
			{{:helper.link('Cycle to Exterior', 'arrowthickstop-1-w', {'command' : 'cycle_ext'}, data.processing ? 'disabled' : null)}}
			{{:helper.link('Cycle to Interior', 'arrowthickstop-1-e', {'command' : 'cycle_int'}, data.processing ? 'disabled' : null)}}
		</div>
		<div class="itemContent" style="padding-top: 2px">
			{{:helper.link('Force exterior door', 'alert', {'command' : 'force_ext'}, null, data.processing ? 'yellowButton' : null)}}
			{{:helper.link('Force interior door', 'alert', {'command' : 'force_int'}, null, data.processing ? 'yellowButton' : null)}}
		</div>
	</div>
	<div style="padding-left: 10px; width: 80px; float: left">
		<div class="item">
			<div class="itemContent" style="padding-bottom: 2px; width: auto">
				{{:helper.link('Purge', 'refresh', {'command' : 'purge'}, data.processing ? 'disabled' : null, data.purge ? 'linkOn' : null)}}
			</div>
			<div class="itemContent" style="width: auto">
				{{:helper.link('Secure', data.secure ? 'locked' : 'unlocked', {'command' : 'secure'}, data.processing ? 'disabled' : null, data.secure ? 'linkOn' : null)}}
			</div>
		</div>
	</div>
	<div class="item" style="padding-top: 10px">
			{{:helper.link('Abort', 'cancel', {'command' : 'abort'}, data.processing ? null : 'disabled', data.processing ? 'redButton' : null)}}
	</div>
</div>