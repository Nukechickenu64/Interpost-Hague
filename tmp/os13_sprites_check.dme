#define FILE_DIR ".."
#define NOPOWER 1
#define BROKEN 2
/obj
    var/light_output = 0
/obj/proc/set_light(range, power)
    light_output = range
/obj/machinery/computer
    icon = 'icons/obj/computer.dmi'
    icon_state = "computer"
    var/base_icon_state
    var/stat = 0
    var/overlay_layer
    var/icon_keyboard = "generic_key"
    var/icon_screen = "generic"
    var/light_range_on = 2
    var/light_power_on = 1
/obj/item/modular_computer
    var/enabled = 0
    var/damage = 0
    var/broken_damage = 150
    var/light_strength = 4
    var/icon_state_menu = "menu"
    var/icon_state_unpowered = "console"
    var/icon_state_screensaver = "standby"
    var/bsod = 0
    var/updating = 0
    var/datum/program/active_program
/obj/item/modular_computer/laptop
    anchored = 1
    icon = 'icons/obj/modular_laptop.dmi'
    var/icon_state_closed = "laptop-closed"
/datum/program
    var/program_icon_state
    var/program_key_state = "generic_key"
/var/checks = 0
/proc/check(condition, message)
    checks++
    if(!condition)
        world.log << "FAIL: [message]"
        del(world)
/proc/check_sprite(obj/target)
    check(target.icon_state in icon_states(target.icon), "Missing sprite [target.icon_state]")
    var/icon/frame = icon(target.icon, target.icon_state, SOUTH, 1)
    check(frame.Width() == 32 && frame.Height() == 32, "Invalid frame [target.icon_state]")
/world/New()
    var/list/screens = list("generic", "command", "comm", "comm_monitor", "comm_logs", "crew", "dna", "medcomp", "id", "security", "explosive", "cameras", "shuttle", "teleport", "robot", "mecha", "supply", "request", "forensic", "holocontrol", "solar", "ai-fixer", "power", "power_screen", "solar_screen", "turbinecomp", "engines", "fuel_screen", "gyrotron_screen", "rust_screen", "area_atmos", "tank", "helm", "alert:0", "alert:1", "alert:2", "rdcomp", "mass_driver", "mining", "engie_cams", "library", "error", "syndie", "syndishuttle", "tcboss", "medlaptop", "atmoslaptop", "retro", "laptop", "pass")
    var/obj/machinery/computer/C = new
    for(var/screen in screens)
        C.icon_screen = screen
        for(var/status in list(0, NOPOWER, NOPOWER, 0, BROKEN, 0))
            C.stat = status
            C.update_icon()
            check_sprite(C)
            check(C.overlays.len == 0, "Legacy overlays on [screen]")
            check(C.light_output == (status == NOPOWER ? 0 : 2), "Computer power light")
        check(C.icon_state == "os13_[screen]", "Computer failed to restore [screen]")
    for(var/chassis in list("retrosmall", "oldcomp", "laptop", "guest", "tcstation"))
        C.base_icon_state = chassis
        for(var/status in list(0, NOPOWER, NOPOWER, 0, BROKEN, 0))
            C.stat = status
            C.update_icon()
            check_sprite(C)
    C.base_icon_state = "arcade"
    C.icon_screen = "invaders"
    C.icon_keyboard = null
    for(var/status in list(NOPOWER, NOPOWER, 0, BROKEN, 0))
        C.stat = status
        C.update_icon()
        check_sprite(C)
    check(C.icon_state == "arcade", "Legacy chassis failed to restore")
    var/list/programs = list("generic", "command", "comm", "comm_monitor", "comm_logs", "crew", "dna", "medcomp", "id", "security", "explosive", "cameras", "shuttle", "teleport", "robot", "mecha", "supply", "request", "forensic", "holocontrol", "solar", "menu", "medical", "operating", "engine", "research", "dummy", "upload", "ai-fixer-empty", "ai-fixer-full", "alert-green", "alert-red", "warrant", "hostile", "entertainment", "game", "power_monitor", "power_monitor_warn", "alarm_monitor", "atmos_control", "word", "shield", "bsod", "smmon_0", "smmon_1", "smmon_2", "smmon_3", "smmon_4", "smmon_5", "smmon_6")
    for(var/device_icon in list('icons/obj/modular_console.dmi', 'icons/obj/modular_laptop.dmi'))
        var/obj/item/modular_computer/M = new
        M.icon = device_icon
        M.active_program = new
        for(var/screen in programs)
            M.active_program.program_icon_state = screen
            for(var/powered in list(1, 0, 0, 1))
                M.enabled = powered
                M.update_icon()
                check_sprite(M)
                check(M.overlays.len == 0, "Legacy modular overlays on [screen]")
                check(M.light_output == (powered ? 4 : 0), "Modular power light")
            check(M.icon_state == "os13_[screen]", "Modular failed to restore [screen]")
            M.damage = 151
            M.update_icon()
            check_sprite(M)
            check(M.icon_state == "os13_[screen]_broken", "Modular damage sprite")
            check(M.light_output == 0, "Damaged modular light")
            M.damage = 0
        M.bsod = 1
        M.update_icon()
        check(M.icon_state == "os13_bsod", "Modular crash sprite")
        M.enabled = 0
        M.update_icon()
        check(M.light_output == 0, "Disabled crash light")
        M.bsod = 0
        M.active_program = null
        M.enabled = 1
        M.update_icon()
        check(M.icon_state == "os13_menu", "Modular menu sprite")
        del(M)
    var/obj/item/modular_computer/laptop/L = new
    L.enabled = 1
    L.update_icon()
    check(L.icon_state == "os13_menu", "Open laptop sprite")
    L.anchored = 0
    L.update_icon()
    check(L.icon_state == "laptop-closed", "Closed laptop sprite")
    check_sprite(L)
    world.log << "PASS: [checks] computer sprite and power-transition checks"
    del(world)
/obj/machinery/computer/New()
	overlay_layer = layer
	base_icon_state = icon_state
	..()

/obj/machinery/computer/update_icon()
	overlays.Cut()
	icon_state = base_icon_state
	// OS13 states include the casing and keyboard, so do not add legacy overlays.
	if(icon == 'icons/obj/computer.dmi')
		var/full_state
		switch(base_icon_state)
			if("computer", "retrosmall")
				full_state = "os13_[icon_screen]"
			if("oldcomp")
				full_state = "os13_retro"
			if("laptop")
				full_state = "os13_laptop"
			if("guest")
				full_state = "os13_pass"
			if("tcstation")
				full_state = "os13_syndie"
		if(full_state && (full_state in icon_states(icon)))
			if(stat & NOPOWER)
				icon_state = "[full_state]_off"
				set_light(0)
			else
				icon_state = (stat & BROKEN) ? "[full_state]_broken" : full_state
				set_light(light_range_on, light_power_on)
			return

	if(stat & NOPOWER)
		set_light(0)
		if("[base_icon_state]_off" in icon_states(icon))
			icon_state = "[base_icon_state]_off"
		if(icon_keyboard)
			overlays += image(icon,"[icon_keyboard]_off", overlay_layer)
		return
	else
		set_light(light_range_on, light_power_on)

	if(stat & BROKEN)
		overlays += image(icon,"[icon_state]_broken", overlay_layer)
	else
		overlays += image(icon,icon_screen, overlay_layer)

	if(icon_keyboard)
		overlays += image(icon, icon_keyboard, overlay_layer)

/obj/item/modular_computer/update_icon()
	// Complete OS13 sprites already contain their screen, casing, and keyboard.
	if(icon == 'icons/obj/modular_console.dmi' || icon == 'icons/obj/modular_laptop.dmi')
		var/screen_state = (active_program && active_program.program_icon_state) ? active_program.program_icon_state : icon_state_menu
		var/full_state = "os13_[screen_state]"
		if(full_state in icon_states(icon))
			overlays.Cut()
			set_light(enabled ? light_strength : 0)
			if(damage > broken_damage)
				icon_state = "[full_state]_broken"
				set_light(0)
			else if(!enabled)
				icon_state = "[full_state]_off"
			else if(bsod || updating)
				icon_state = "os13_bsod"
			else
				icon_state = full_state
			return

	icon_state = icon_state_unpowered

	overlays.Cut()
	if(bsod || updating)
		overlays.Add("bsod")
		return
	if(!enabled)
		if(icon_state_screensaver)
			overlays.Add(icon_state_screensaver)
		set_light(0)
		return
	set_light(light_strength)
	if(active_program)
		overlays.Add(active_program.program_icon_state ? active_program.program_icon_state : icon_state_menu)
		if(active_program.program_key_state)
			overlays.Add(active_program.program_key_state)
	else
		overlays.Add(icon_state_menu)

/obj/item/modular_computer/laptop/update_icon()
	if(anchored)
		..()
	else
		overlays.Cut()
		icon_state = icon_state_closed

