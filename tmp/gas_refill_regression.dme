/datum/controller/subsystem/unit_tests/Initialize(timeofday)
	queue = list(new /datum/unit_test/atmos_machinery/canister_refill, new /datum/unit_test/atmos_machinery/modcon_recovery, new /datum/unit_test/atmos_machinery/modcon_refill, new /datum/unit_test/atmos_machinery/station_supply, new /datum/unit_test/movement/jetpack_vertical_thrust, new /datum/unit_test/movement/jetpack_horizontal_thrust)
	log_unit_test("Running focused gas refill, modcon and jetpack regression tests.")
	. = ..()